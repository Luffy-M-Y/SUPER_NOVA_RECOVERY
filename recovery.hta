<!DOCTYPE html>
<html>
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
<title>SUPER NOVA RECOVERY</title>
<HTA:APPLICATION
    ID="SuperNovaRecovery"
    APPLICATIONNAME="SuperNovaRecovery"
    BORDER="thin"
    BORDERSTYLE="normal"
    CAPTION="yes"
    MAXIMIZEBUTTON="no"
    MINIMIZEBUTTON="no"
    SHOWINTASKBAR="yes"
    SINGLEINSTANCE="yes"
    SYSMENU="yes"
    WINDOWSTATE="normal"
    SCROLL="no"
    INNERBORDER="no"
/>
<style>
* { margin: 0; padding: 0; box-sizing: border-box; }

html, body {
    height: 100%;
    width: 100%;
    margin: 0;
    padding: 0;
    background: #171717;
}

body {
    color: #f2f2f2;
    font-family: 'Segoe UI', Tahoma, sans-serif;
    overflow: hidden;
    display: table;
    width: 100%;
    height: 100%;
}

#app-wrapper {
    display: table-cell;
    vertical-align: middle;
    text-align: center;
}

#app {
    display: inline-block;
    text-align: left;
    width: 90%;
    max-width: 860px;
    background: #202020;
    border: 1px solid #363636;
    border-radius: 10px;
    padding: 36px 56px;
    box-shadow: 0 12px 35px rgba(0,0,0,0.35);
    overflow-y: auto;
}

.logo {
    text-align: center;
    margin-bottom: 30px;
}

.logo h1 {
    font-size: 21px;
    font-weight: 600;
    color: #f2f2f2;
    letter-spacing: 1.5px;
    text-transform: uppercase;
}

.logo p {
    font-size: 12px;
    color: #8f8f8f;
    margin-top: 6px;
    letter-spacing: 0.5px;
}

.screen { display: none; }
.screen.active { display: block; }

.status-box {
    background: #282828;
    border: 1px solid #363636;
    border-radius: 7px;
    padding: 16px 20px;
    margin-bottom: 20px;
    font-size: 13px;
    line-height: 1.8;
    min-height: 80px;
}

.status-box .label {
    color: #858585;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 8px;
}

.found { color: #4caf7d; }
.error { color: #d96c6c; }
.warn  { color: #d6a354; }
.info  { color: #8aaee8; }

.btn {
    width: 100%;
    padding: 13px 14px;
    border: none;
    border-radius: 6px;
    font-family: 'Segoe UI', Tahoma, sans-serif;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.3px;
    cursor: pointer;
    transition: background-color 0.15s ease, border-color 0.15s ease, opacity 0.15s ease;
}

.btn:hover { opacity: 0.9; }
.btn:disabled { opacity: 0.4; cursor: not-allowed; }

.btn-primary { background: #5b8def; color: #fff; }
.btn-primary:hover { background: #6797f2; }

.btn-danger  { background: #b85c5c; color: #fff; }
.btn-danger:hover { background: #c26666; }

.btn-ghost   { background: transparent; color: #a6a6a6; border: 1px solid #3a3a3a; margin-top: 10px; }
.btn-ghost:hover { background: #292929; color: #d8d8d8; }

#accounts-list {
    max-height: 220px;
    overflow-y: auto;
    margin-bottom: 14px;
    padding-right: 5px;
}

.account-item {
    background: #282828;
    border: 1px solid #373737;
    border-radius: 6px;
    padding: 12px 16px;
    margin-bottom: 8px;
    cursor: pointer;
    transition: background-color 0.15s ease, border-color 0.15s ease;
    font-size: 13px;
}

.account-item:hover { background: #2d2d2d; border-color: #4a4a4a; }
.account-item.selected { background: #29364d; border-color: #5b8def; }

.account-item .acc-name { font-weight: 600; color: #eeeeee; }
.account-item .acc-type { font-size: 11px; color: #929292; margin-top: 3px; }

.warning-box {
    background: #2b261c;
    border: 1px solid #5b4a2f;
    border-radius: 7px;
    padding: 12px 16px;
    font-size: 12px;
    color: #d6a354;
    margin-bottom: 20px;
    line-height: 1.6;
}

.warning-box strong { color: #e0bd7d; }

.steps {
    background: #282828;
    border: 1px solid #363636;
    border-radius: 7px;
    padding: 16px 20px;
    margin-bottom: 20px;
    font-size: 12px;
    line-height: 2;
    color: #a6a6a6;
}

.steps .step-done { color: #4caf7d; }
.steps .step-title { color: #eeeeee; font-weight: 600; font-size: 13px; margin-bottom: 8px; }

.spinner {
    display: inline-block;
    width: 14px; height: 14px;
    border: 2px solid #3a3a3a;
    border-top-color: #5b8def;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
    vertical-align: middle;
    margin-right: 8px;
}
@keyframes spin { to { transform: rotate(360deg); } }

.section-title {
    font-size: 10px;
    color: #858585;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 12px;
}
</style>
</head>
<body>

<div id="app-wrapper">
<div id="app">
    <div class="logo">
        <h1>⚡ SUPER NOVA RECOVERY</h1>
        <p>Réinitialisation de mot de passe Windows</p>
    </div>

    <!-- ÉCRAN 1 : Détection -->
    <div id="screen-detect" class="screen active">
        <div class="status-box">
            <div class="label">Statut de détection</div>
            <div id="detect-status" class="info">
                <span class="spinner"></span> Recherche de la partition Windows...
            </div>
        </div>
        <button class="btn btn-primary" id="btn-detect" onclick="detectWindows()">
            Analyser les disques
        </button>
    </div>

    <!-- ÉCRAN 2 : Sélection du compte -->
    <div id="screen-accounts" class="screen">
        <div class="section-title">Comptes détectés sur <span id="drive-label"></span></div>
        <div id="accounts-list"></div>
        <div class="warning-box">
            ⚠️ Fonctionne uniquement avec les comptes locaux.<br>
            Compte Microsoft (@outlook, @hotmail) → <strong>account.live.com</strong>
        </div>
        <button class="btn btn-danger" id="btn-reset" onclick="confirmReset()" disabled>
            🔑 Réinitialiser le mot de passe
        </button>
        <button class="btn btn-ghost" onclick="showScreen('screen-detect')">← Retour</button>
    </div>

    <!-- ÉCRAN 3 : Confirmation -->
    <div id="screen-confirm" class="screen">
        <div class="status-box">
            <div class="label">Compte sélectionné</div>
            <div id="confirm-account" style="font-size:15px; font-weight:600; color:#e0e0e0;"></div>
            <div id="confirm-type" style="font-size:12px; color:#4a5568; margin-top:4px;"></div>
        </div>
        <div class="warning-box">
            ⚠️ Cette opération va modifier des fichiers système Windows.<br>
            Assurez-vous d'avoir l'autorisation d'accéder à ce PC.
        </div>
        <button class="btn btn-danger" onclick="executeReset()">
            ✓ Confirmer la réinitialisation
        </button>
        <button class="btn btn-ghost" onclick="showScreen('screen-accounts')">← Annuler</button>
    </div>

    <!-- ÉCRAN 4 : Résultat -->
    <div id="screen-result" class="screen">
        <div class="status-box" id="result-status"></div>
        <div class="steps" id="result-steps"></div>
        <button class="btn btn-primary" id="btn-reboot" style="display:none;" onclick="reboot()">↺ Redémarrer le PC</button>
        <button class="btn btn-ghost" onclick="showScreen('screen-detect')">Recommencer</button>
    </div>
</div>
</div>

<script language="VBScript">
' ─── Exécution de commandes système ───────────────────────────────────────────
Function RunCmd(cmd)
    Dim shell
    Set shell = CreateObject("WScript.Shell")
    RunCmd = shell.Run("cmd.exe /c " & cmd, 0, True)
End Function

Function RunCmdOutput(cmd)
    Dim shell, exec, output
    Set shell = CreateObject("WScript.Shell")
    Set exec = shell.Exec("cmd.exe /c " & cmd)
    output = exec.StdOut.ReadAll()
    RunCmdOutput = output
End Function

Function FileExists(path)
    Dim fso
    Set fso = CreateObject("Scripting.FileSystemObject")
    FileExists = fso.FileExists(path)
End Function

Function FolderExists(path)
    Dim fso
    Set fso = CreateObject("Scripting.FileSystemObject")
    FolderExists = fso.FolderExists(path)
End Function

' ─── Détection de la partition Windows ────────────────────────────────────────
Function FindWindowsDrive()
    Dim drives, d
    drives = Array("C", "D", "E", "F", "G", "H", "I")
    For Each d In drives
        If FileExists(d & ":\Windows\System32\config\SAM") Then
            FindWindowsDrive = d
            Exit Function
        End If
    Next
    FindWindowsDrive = ""
End Function

' ─── Lister les comptes depuis le registre SAM hors-ligne ─────────────────────
Function GetAccounts(winDrive)
    Dim result, output, lines, i, acc
    
    ' Charger le SAM hors-ligne
    RunCmd "reg load HKLM\OFFLINE_SAM """ & winDrive & ":\Windows\System32\config\SAM"""
    
    ' Lister les noms de comptes
    output = RunCmdOutput("reg query ""HKLM\OFFLINE_SAM\SAM\Domains\Account\Users\Names""")
    
    lines = Split(output, vbCrLf)
    Dim accounts()
    Dim count : count = 0
    
    For i = 0 To UBound(lines)
        Dim line : line = Trim(lines(i))
        ' reg query affiche HKEY_LOCAL_MACHINE et non HKLM
        If Left(line, 4) = "HKEY" Then
            ' Extraire le nom du compte (dernière partie du chemin)
            Dim parts : parts = Split(line, "\")
            acc = parts(UBound(parts))
            If acc <> "" And acc <> "Names" Then
                ReDim Preserve accounts(count)
                accounts(count) = acc
                count = count + 1
            End If
        End If
    Next
    
    ' Décharger le SAM
    RunCmd "reg unload HKLM\OFFLINE_SAM"
    
    If count = 0 Then
        GetAccounts = ""
    Else
        GetAccounts = Join(accounts, "|")
    End If
End Function

' ─── Vérifier si BitLocker est actif ──────────────────────────────────────────
Function IsBitLockerActive(winDrive)
    Dim output
    output = RunCmdOutput("manage-bde -status " & winDrive & ":")
    IsBitLockerActive = (InStr(output, "Protection On") > 0)
End Function
</script>

<script language="JavaScript">
// ─── Gestionnaire d'erreurs global ────────────────────────────────────────────
window.onerror = function(msg, url, line) {
    alert("ERREUR CRITIQUE : " + msg + "\nLigne : " + line);
    return true; // Évite l'affichage de la fenêtre d'erreur standard d'IE
};

var selectedAccount = "";
var windowsDrive = "";
var accounts = [];

// ─── Navigation entre écrans ──────────────────────────────────────────────────
var screenIds = ["screen-detect", "screen-accounts", "screen-confirm", "screen-result"];
function showScreen(id) {
    for (var i = 0; i < screenIds.length; i++) {
        document.getElementById(screenIds[i]).className = "screen";
    }
    document.getElementById(id).className = "screen active";
    if (id === "screen-accounts") {
        selectedAccount = "";
        document.getElementById("btn-reset").disabled = true;
        document.getElementById("btn-reset").style.border = "";
        var err = document.getElementById("no-account-error");
        if (err) err.parentNode.removeChild(err);
    }
}

// ─── Détection au chargement ──────────────────────────────────────────────────
window.onload = function() {
    var w = Math.round(screen.width  * 0.75);
    var h = Math.round(screen.height * 0.80);
    window.resizeTo(w, h);
    window.moveTo(
        Math.round((screen.width  - w) / 2),
        Math.round((screen.height - h) / 2)
    );
    document.getElementById("app").style.maxHeight = Math.round(h * 0.88) + "px";
    document.getElementById("accounts-list").style.maxHeight = Math.round(h * 0.30) + "px";
    setTimeout(detectWindows, 500);
};

function detectWindows() {
    var statusEl = document.getElementById("detect-status");
    statusEl.innerHTML = '<span class="spinner"></span> Recherche en cours...';
    try {
        var drive = FindWindowsDrive();
        if (drive === "") {
            statusEl.innerHTML = '<span class="error">✗ Partition Windows introuvable.</span>';
            return;
        }
        windowsDrive = drive;
        if (IsBitLockerActive(drive)) {
            statusEl.innerHTML = '<span class="warn">⚠ BitLocker d\u00e9tect\u00e9 sur ' + drive + ':\\</span>';
            return;
        }
        statusEl.innerHTML = '<span class="found">✓ Windows trouv\u00e9 sur ' + drive + ':\\</span>';
        loadAccounts(drive);
    } catch(e) {
        statusEl.innerHTML = '<span class="error">✗ Erreur : ' + e.message + '</span>';
    }
}

function loadAccounts(drive) {
    try {
        var rawString = GetAccounts(drive);
        accounts = [];

        if (rawString !== "") {
            var splitted = rawString.split("|");
            for (var i = 0; i < splitted.length; i++) {
                if (splitted[i] !== "") {
                    accounts.push(splitted[i]);
                }
            }
        }

        if (accounts.length === 0) {
            document.getElementById("detect-status").innerHTML = '<span class="error">✗ Aucun compte trouv\u00e9.</span>';
            return;
        }
        document.getElementById("drive-label").textContent = drive + ":\\Windows";
        renderAccounts();
        showScreen("screen-accounts");
    } catch(e) {
        document.getElementById("detect-status").innerHTML = '<span class="error">✗ SAM illisible : ' + e.message + '</span>';
    }
}

function renderAccounts() {
    var list = document.getElementById("accounts-list");
    list.innerHTML = "";
    for (var i = 0; i < accounts.length; i++) {
        var name = accounts[i];
        var isAdmin = (name.toLowerCase() === "administrateur" || name.toLowerCase() === "administrator");
        var div = document.createElement("div");
        div.className = "account-item";
        div.setAttribute("data-name", name);
        div.innerHTML = '<div class="acc-name">👤 ' + name + '</div><div class="acc-type">' + (isAdmin ? "Administrateur int\u00e9gr\u00e9" : "Compte Windows") + '</div>';
        div.onclick = function() { selectAccount(this); };
        list.appendChild(div);
    }
}

function selectAccount(el) {
    var container = document.getElementById("accounts-list");
    var divs = container.getElementsByTagName("div");
    for (var i = 0; i < divs.length; i++) {
        if (divs[i].parentNode === container) { divs[i].className = "account-item"; }
    }
    el.className = "account-item selected";
    selectedAccount = el.getAttribute("data-name");
    document.getElementById("btn-reset").disabled = false;
    document.getElementById("btn-reset").style.border = "";
    var err = document.getElementById("no-account-error");
    if (err) err.parentNode.removeChild(err);
}

function confirmReset() {
    if (!selectedAccount) {
        document.getElementById("btn-reset").style.border = "2px solid #fc8181";
        var existing = document.getElementById("no-account-error");
        if (!existing) {
            var err = document.createElement("div");
            err.id = "no-account-error";
            err.style.cssText = "color:#d96c6c;font-size:12px;margin-top:8px;text-align:center;";
            err.textContent = "\u26a0 Veuillez s\u00e9lectionner un compte avant de continuer.";
            document.getElementById("btn-reset").parentNode.insertBefore(err, document.getElementById("btn-reset").nextSibling);
        }
        return;
    }
    document.getElementById("confirm-account").innerHTML = "&#128100; " + selectedAccount;
    var isAdmin = (selectedAccount.toLowerCase() === "administrateur" || selectedAccount.toLowerCase() === "administrator");
    document.getElementById("confirm-type").innerHTML = isAdmin ? "Administrateur int\u00e9gr\u00e9" : "Compte Windows \u2014 " + windowsDrive + ":\\Windows";
    showScreen("screen-confirm");
}

function executeReset() {
    showScreen("screen-result");
    document.getElementById("result-status").innerHTML = '<div class="label">Op\u00e9ration en cours</div><span class="spinner"></span> Application des modifications...';
    document.getElementById("result-steps").innerHTML = "";
    try {
        var drive = windowsDrive;
        var steps = [];
        var success = true;

        // 1. Création du dossier C:\SuperNova
        var snFolder = drive + ":\\SuperNova";
        if (!FolderExists(snFolder)) {
            var fso = new ActiveXObject("Scripting.FileSystemObject");
            fso.CreateFolder(snFolder);
        }

        // 2. Création du script recovery_script.bat
        var batPath = snFolder + "\\recovery_script.bat";
        var batContent = "@echo off\r\n" +
            "color 0F\r\n" +
            "mode con cols=84 lines=34\r\n" +
            "title SUPER NOVA RECOVERY\r\n" +
            "cls\r\n" +
            "echo =========================================\r\n" +
            "echo          SUPER NOVA RECOVERY\r\n" +
            "echo =========================================\r\n" +
            "echo.\r\n" +
            "echo Compte cible : " + selectedAccount + "\r\n" +
            "echo.\r\n" +
            "set /p newpwd=\"Entrez le nouveau mot de passe : \"\r\n" +
            "echo.\r\n" +
            "net user \"" + selectedAccount + "\" %newpwd%\r\n" +
            "if %ERRORLEVEL% EQU 0 goto :SUCCESS\r\n" +
            "goto :MS_ACCOUNT\r\n" +
            "\r\n" +
            ":SUCCESS\r\n" +
            "echo.\r\n" +
            "echo [SUCCES] Le mot de passe a ete reinitialise !\r\n" +
            "echo Finalisation en cours...\r\n" +
            "reg delete \"HKLM\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Image File Execution Options\\sethc.exe\" /v Debugger /f >nul 2>&1\r\n" +
            "echo L'ordinateur va redemarrer dans 10 secondes pour appliquer les changements.\r\n" +
            "shutdown /r /t 10\r\n" +
            "pause\r\n" +
            "goto :CLEANUP\r\n" +
            "\r\n" +
            ":MS_ACCOUNT\r\n" +
            "echo.\r\n" +
            "echo =========================================\r\n" +
            "echo  COMPTE MICROSOFT DETECTE\r\n" +
            "echo =========================================\r\n" +
            "echo.\r\n" +
            "echo Ce compte est lie a Microsoft.\r\n" +
            "echo Pour changer le mot de passe, rendez-vous sur :\r\n" +
            "echo    https://account.live.com/password/reset\r\n" +
            "echo.\r\n" +
            "echo Cependant, vous pouvez recuperer vos donnees !\r\n" +
            "echo.\r\n" +
            "echo 1 - Recuperer mes donnees (creer un compte de secours)\r\n" +
            "echo 2 - Quitter\r\n" +
            "echo.\r\n" +
            "set /p choice=\"Choix : \"\r\n" +
            "if \"%choice%\"==\"1\" goto :RECOVER\r\n" +
            "goto :QUIT\r\n" +
            "\r\n" +
            ":RECOVER\r\n" +
            "echo.\r\n" +
            "echo Creation du compte SuperNovaAdmin...\r\n" +
            "net user SuperNovaAdmin \"\" /add >nul 2>&1\r\n" +
            "net localgroup Administrateurs SuperNovaAdmin /add >nul 2>&1\r\n" +
            "net localgroup Administrators SuperNovaAdmin /add >nul 2>&1\r\n" +
            "echo [OK] Compte SuperNovaAdmin cree avec succes.\r\n" +
            "echo.\r\n" +
            "echo Preparation de l'outil de transfert...\r\n" +
            "echo @echo off > \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo color 0F >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo mode con cols=84 lines=34 >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo title SUPER NOVA - Recuperation de donnees >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo cls >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo fsutil dirty query %%systemdrive%% ^>nul >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo if %%errorLevel%% NEQ 0 ( >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo     echo Demande d'autorisation... >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo     powershell -Command \"Start-Process '%%~f0' -Verb RunAs\" >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo     exit /b >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo ) >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo echo ========================================= >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo echo    SUPER NOVA - Recuperation de donnees >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo echo ========================================= >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo echo. >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo echo Copie de vos fichiers en cours... >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo echo. >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo mkdir \"C:\\Backup_" + selectedAccount + "\" 2^>nul >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo robocopy \"C:\\Users\\" + selectedAccount + "\\Desktop\" \"C:\\Backup_" + selectedAccount + "\\Bureau\" /E /MT:8 /R:1 /W:1 /NP >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo robocopy \"C:\\Users\\" + selectedAccount + "\\Documents\" \"C:\\Backup_" + selectedAccount + "\\Documents\" /E /MT:8 /R:1 /W:1 /NP >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo robocopy \"C:\\Users\\" + selectedAccount + "\\Pictures\" \"C:\\Backup_" + selectedAccount + "\\Images\" /E /MT:8 /R:1 /W:1 /NP >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo robocopy \"C:\\Users\\" + selectedAccount + "\\Downloads\" \"C:\\Backup_" + selectedAccount + "\\Telechargements\" /E /MT:8 /R:1 /W:1 /NP >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo robocopy \"C:\\Users\\" + selectedAccount + "\\Videos\" \"C:\\Backup_" + selectedAccount + "\\Videos\" /E /MT:8 /R:1 /W:1 /NP >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo echo. >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo echo ========================================= >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo echo  COPIE TERMINEE ! >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo echo ========================================= >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo echo. >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo if exist \"C:\\Backup_" + selectedAccount + "\\Bureau\" ( >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo     echo [SUCCES] La sauvegarde a reussi ! >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo     echo Vos fichiers sont prets pour le transfert final. >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo ) else ( >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo     echo [ERREUR] La sauvegarde a echoue ou aucun fichier n'a ete copie. >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo     echo Si vous n'avez pas accepte la demande d'autorisation, >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo     echo veuillez relancer le programme. >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo     pause >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo     exit /b >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo ) >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo echo. >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo echo ======================================================== >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo echo Voulez-vous creer un NOUVEAU compte permanent pour utiliser ce PC ? ^(O/N^) >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo set /p createAccount=\"Choix : \" >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo if /I \"%%createAccount%%\"==\"O\" goto :CREATE_ACCOUNT >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo if /I \"%%createAccount%%\"==\"N\" goto :KEEP_ADMIN >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo goto :END_SCRIPT >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo. >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo :CREATE_ACCOUNT >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo echo. >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo set /p newUser=\"Nom du nouveau compte : \" >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo set /p newPass=\"Mot de passe (Notez-le bien !) : \" >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo net user \"%%newUser%%\" \"%%newPass%%\" /add ^>nul 2^>^&1 >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo net localgroup Administrateurs \"%%newUser%%\" /add ^>nul 2^>^&1 >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo net localgroup Administrators \"%%newUser%%\" /add ^>nul 2^>^&1 >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo echo [OK] Le compte %%newUser%% a ete cree avec succes et est Administrateur ! >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo echo. >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo echo [OK] Outil de finalisation prepare. >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo copy \"C:\\ProgramData\\SuperNova\\NettoyageFinal.bat\" \"C:\\Users\\Default\\Desktop\\NettoyageFinal.bat\" ^>nul 2^>^&1 >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo echo. >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo echo ======================================================== >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo echo FELICITATIONS ! Votre nouveau compte a ete cree. >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo echo. >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo echo Le PC va redemarrer dans 15 secondes. >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo echo 1. Connectez-vous avec votre nouveau compte. >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo echo 2. Double-cliquez sur \"NettoyageFinal\" sur le bureau. >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo echo 3. Lancez l'outil de finalisation. >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo echo ======================================================== >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo shutdown /r /t 15 >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo timeout /t 14 /nobreak ^>nul >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo ^(goto^) 2^>nul ^& del \"%%~f0\" >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo. >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo :KEEP_ADMIN >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo echo. >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo echo Vous avez choisi de garder le compte SuperNovaAdmin. >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo echo Transfert des donnees vers vos dossiers personnels... >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo robocopy \"C:\\Backup_" + selectedAccount + "\\Bureau\" \"%%USERPROFILE%%\\Desktop\" /E /MOVE /IS /R:1 /W:1 ^>nul 2^>^&1 >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo robocopy \"C:\\Backup_" + selectedAccount + "\\Documents\" \"%%USERPROFILE%%\\Documents\" /E /MOVE /IS /R:1 /W:1 ^>nul 2^>^&1 >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo robocopy \"C:\\Backup_" + selectedAccount + "\\Images\" \"%%USERPROFILE%%\\Pictures\" /E /MOVE /IS /R:1 /W:1 ^>nul 2^>^&1 >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo robocopy \"C:\\Backup_" + selectedAccount + "\\Telechargements\" \"%%USERPROFILE%%\\Downloads\" /E /MOVE /IS /R:1 /W:1 ^>nul 2^>^&1 >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo robocopy \"C:\\Backup_" + selectedAccount + "\\Videos\" \"%%USERPROFILE%%\\Videos\" /E /MOVE /IS /R:1 /W:1 ^>nul 2^>^&1 >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo rd /s /q \"C:\\Backup_" + selectedAccount + "\" ^>nul 2^>^&1 >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo echo [OK] Transfert termine avec succes ! >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo echo. >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo echo Veuillez definir un mot de passe OBLIGATOIRE pour securiser le compte. >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo :PWD_LOOP >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo set \"adminPass=\" >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo set /p adminPass=\"Mot de passe : \" >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo if \"%%adminPass%%\"==\"\" goto :PWD_LOOP >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo net user SuperNovaAdmin \"%%adminPass%%\" ^>nul 2^>^&1 >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo echo [OK] Mot de passe enregistre. >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo rd /s /q \"C:\\ProgramData\\SuperNova\" ^>nul 2^>^&1 >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo echo Le PC va redemarrer dans 15 secondes... >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo shutdown /r /t 15 >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo timeout /t 14 /nobreak ^>nul >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo ^(goto^) 2^>nul ^& del \"%%~f0\" >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo. >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo :END_SCRIPT >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo ^(goto^) 2^>nul ^& del \"%%~f0\" >> \"%public%\\Desktop\\CopyData.bat\"\r\n" +
            "echo.\r\n" +
            "echo.\r\n" +
            "echo =========================================\r\n" +
            "echo  Preparation de l'outil de finalisation...\r\n" +
            "echo =========================================\r\n" +
            "set \"NF=C:\\ProgramData\\SuperNova\\NettoyageFinal.bat\"\r\n" +
            "mkdir \"C:\\ProgramData\\SuperNova\" 2>nul\r\n" +
            "echo @echo off > \"%NF%\"\r\n" +
            "echo color 0F >> \"%NF%\"\r\n" +
            "echo mode con cols=84 lines=34 >> \"%NF%\"\r\n" +
            "echo title SUPER NOVA - Nettoyage Final >> \"%NF%\"\r\n" +
            "echo cls >> \"%NF%\"\r\n" +
            "echo fsutil dirty query %%systemdrive%% ^>nul >> \"%NF%\"\r\n" +
            "echo if %%errorLevel%% NEQ 0 ( >> \"%NF%\"\r\n" +
            "echo     echo Demande d'autorisation... >> \"%NF%\"\r\n" +
            "echo     powershell -Command \"Start-Process '%%~f0' -Verb RunAs\" >> \"%NF%\"\r\n" +
            "echo     exit /b >> \"%NF%\"\r\n" +
            "echo ) >> \"%NF%\"\r\n" +
            "echo echo ========================================= >> \"%NF%\"\r\n" +
            "echo echo    SUPER NOVA - Finalisation >> \"%NF%\"\r\n" +
            "echo echo ========================================= >> \"%NF%\"\r\n" +
            "echo echo. >> \"%NF%\"\r\n" +
            "echo echo Voulez-vous supprimer le compte temporaire SuperNovaAdmin ? (O/N) >> \"%NF%\"\r\n" +
            "echo set /p clean=\"Choix : \" >> \"%NF%\"\r\n" +
            "echo if /I \"%%clean%%\"==\"O\" goto :DO_CLEAN >> \"%NF%\"\r\n" +
            "echo goto :SKIP_CLEAN >> \"%NF%\"\r\n" +
            "echo :DO_CLEAN >> \"%NF%\"\r\n" +
            "echo echo. >> \"%NF%\"\r\n" +
            "echo echo Transfert des donnees vers votre nouveau compte... >> \"%NF%\"\r\n" +
            "echo robocopy \"C:\\Backup_" + selectedAccount + "\\Bureau\" \"%%USERPROFILE%%\\Desktop\" /E /MOVE /IS /R:1 /W:1 ^>nul 2^>^&1 >> \"%NF%\"\r\n" +
            "echo robocopy \"C:\\Backup_" + selectedAccount + "\\Documents\" \"%%USERPROFILE%%\\Documents\" /E /MOVE /IS /R:1 /W:1 ^>nul 2^>^&1 >> \"%NF%\"\r\n" +
            "echo robocopy \"C:\\Backup_" + selectedAccount + "\\Images\" \"%%USERPROFILE%%\\Pictures\" /E /MOVE /IS /R:1 /W:1 ^>nul 2^>^&1 >> \"%NF%\"\r\n" +
            "echo robocopy \"C:\\Backup_" + selectedAccount + "\\Telechargements\" \"%%USERPROFILE%%\\Downloads\" /E /MOVE /IS /R:1 /W:1 ^>nul 2^>^&1 >> \"%NF%\"\r\n" +
            "echo robocopy \"C:\\Backup_" + selectedAccount + "\\Videos\" \"%%USERPROFILE%%\\Videos\" /E /MOVE /IS /R:1 /W:1 ^>nul 2^>^&1 >> \"%NF%\"\r\n" +
            "echo rd /s /q \"C:\\Backup_" + selectedAccount + "\" ^>nul 2^>^&1 >> \"%NF%\"\r\n" +
            "echo echo [OK] Transfert termine avec succes ! >> \"%NF%\"\r\n" +
            "echo echo. >> \"%NF%\"\r\n" +
            "echo echo Suppression du compte SuperNovaAdmin... >> \"%NF%\"\r\n" +
            "echo net user SuperNovaAdmin /delete ^>nul 2^>^&1 >> \"%NF%\"\r\n" +
            "echo rd /s /q \"C:\\Users\\SuperNovaAdmin\" ^>nul 2^>^&1 >> \"%NF%\"\r\n" +
            "echo rd /s /q \"C:\\ProgramData\\SuperNova\" ^>nul 2^>^&1 >> \"%NF%\"\r\n" +
            "echo del \"C:\\Users\\Default\\Desktop\\NettoyageFinal.bat\" ^>nul 2^>^&1 >> \"%NF%\"\r\n" +
            "echo echo. >> \"%NF%\"\r\n" +
            "echo echo [OK] Compte SuperNovaAdmin supprime avec succes ! >> \"%NF%\"\r\n" +
            "echo echo. >> \"%NF%\"\r\n" +
            "echo echo Vos donnees ont ete deplacees dans vos dossiers personnels. >> \"%NF%\"\r\n" +
            "echo echo. >> \"%NF%\"\r\n" +
            "echo echo Le PC va redemarrer dans 15 secondes pour appliquer les modifications. >> \"%NF%\"\r\n" +
            "echo shutdown /r /t 15 >> \"%NF%\"\r\n" +
            "echo del \"%%public%%\\Desktop\\CopyData.bat\" ^>nul 2^>^&1 >> \"%NF%\"\r\n" +
            "echo timeout /t 14 /nobreak ^>nul >> \"%NF%\"\r\n" +
            "echo ^(goto^) 2^>nul ^& del \"%%~f0\" >> \"%NF%\"\r\n" +
            "echo :SKIP_CLEAN >> \"%NF%\"\r\n" +
            "echo echo. >> \"%NF%\"\r\n" +
            "echo echo Vous avez choisi de CONSERVER le compte SuperNovaAdmin. >> \"%NF%\"\r\n" +
            "echo echo Transfert des donnees vers le compte SuperNovaAdmin... >> \"%NF%\"\r\n" +
            "echo robocopy \"C:\\Backup_" + selectedAccount + "\\Bureau\" \"C:\\Users\\SuperNovaAdmin\\Desktop\" /E /MOVE /IS /R:1 /W:1 ^>nul 2^>^&1 >> \"%NF%\"\r\n" +
            "echo robocopy \"C:\\Backup_" + selectedAccount + "\\Documents\" \"C:\\Users\\SuperNovaAdmin\\Documents\" /E /MOVE /IS /R:1 /W:1 ^>nul 2^>^&1 >> \"%NF%\"\r\n" +
            "echo robocopy \"C:\\Backup_" + selectedAccount + "\\Images\" \"C:\\Users\\SuperNovaAdmin\\Pictures\" /E /MOVE /IS /R:1 /W:1 ^>nul 2^>^&1 >> \"%NF%\"\r\n" +
            "echo robocopy \"C:\\Backup_" + selectedAccount + "\\Telechargements\" \"C:\\Users\\SuperNovaAdmin\\Downloads\" /E /MOVE /IS /R:1 /W:1 ^>nul 2^>^&1 >> \"%NF%\"\r\n" +
            "echo robocopy \"C:\\Backup_" + selectedAccount + "\\Videos\" \"C:\\Users\\SuperNovaAdmin\\Videos\" /E /MOVE /IS /R:1 /W:1 ^>nul 2^>^&1 >> \"%NF%\"\r\n" +
            "echo rd /s /q \"C:\\Backup_" + selectedAccount + "\" ^>nul 2^>^&1 >> \"%NF%\"\r\n" +
            "echo echo [OK] Transfert termine avec succes ! >> \"%NF%\"\r\n" +
            "echo echo. >> \"%NF%\"\r\n" +
            "echo echo Ce compte n'a actuellement pas de mot de passe. >> \"%NF%\"\r\n" +
            "echo :PWD_LOOP2 >> \"%NF%\"\r\n" +
            "echo set \"adminPass=\" >> \"%NF%\"\r\n" +
            "echo set /p adminPass=\"Veuillez definir un mot de passe pour le securiser : \" >> \"%NF%\"\r\n" +
            "echo if \"%%adminPass%%\"==\"\" goto :PWD_LOOP2 >> \"%NF%\"\r\n" +
            "echo net user SuperNovaAdmin \"%%adminPass%%\" ^>nul 2^>^&1 >> \"%NF%\"\r\n" +
            "echo echo [OK] Mot de passe enregistre. >> \"%NF%\"\r\n" +
            "echo echo. >> \"%NF%\"\r\n" +
            "echo rd /s /q \"C:\\ProgramData\\SuperNova\" ^>nul 2^>^&1 >> \"%NF%\"\r\n" +
            "echo del \"C:\\Users\\Default\\Desktop\\NettoyageFinal.bat\" ^>nul 2^>^&1 >> \"%NF%\"\r\n" +
            "echo echo Le PC va redemarrer dans 15 secondes pour appliquer les modifications. >> \"%NF%\"\r\n" +
            "echo shutdown /r /t 15 >> \"%NF%\"\r\n" +
            "echo timeout /t 14 /nobreak ^>nul >> \"%NF%\"\r\n" +
            "echo ^(goto^) 2^>nul ^& del \"%%~f0\" >> \"%NF%\"\r\n" +
            "echo.\r\n" +
            "echo [OK] Outil de finalisation genere.\r\n" +
            "echo.\r\n" +
            "echo [OK] Outil de transfert installe sur le Bureau.\r\n" +
            "echo.\r\n" +
            "echo =========================================\r\n" +
            "echo  PROCHAINES ETAPES :\r\n" +
            "echo =========================================\r\n" +
            "echo 1. Le PC va redemarrer automatiquement.\r\n" +
            "echo 2. Connectez-vous au compte \"SuperNovaAdmin\".\r\n" +
            "echo 3. Lancez \"CopyData\" sur le Bureau.\r\n" +
            "echo 4. Vos fichiers seront transferes.\r\n" +
            "echo.\r\n" +
            "reg delete \"HKLM\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Image File Execution Options\\sethc.exe\" /v Debugger /f >nul 2>&1\r\n" +
            "echo Redemarrage dans 15 secondes...\r\n" +
            "shutdown /r /t 15\r\n" +
            "timeout /t 14 /nobreak >nul\r\n" +
            "goto :CLEANUP\r\n" +
            "\r\n" +
            ":QUIT\r\n" +
            "reg delete \"HKLM\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Image File Execution Options\\sethc.exe\" /v Debugger /f >nul 2>&1\r\n" +
            "goto :CLEANUP\r\n" +
            "\r\n" +
            ":CLEANUP\r\n" +
            "(goto) 2>nul & del \"%~f0\" & rd /s /q \"" + snFolder + "\"\r\n";
        var fso2 = new ActiveXObject("Scripting.FileSystemObject");
        var file = fso2.CreateTextFile(batPath, true);
        file.Write(batContent);
        file.Close();
        steps.push("✓ Script de r\u00e9initialisation g\u00e9n\u00e9r\u00e9");

        // 3. Injection IFEO
        RunCmd("reg load HKLM\\OFFLINE_SOFTWARE \"" + drive + ":\\Windows\\System32\\config\\SOFTWARE\"");
        var ifeoCmd = "reg add \"HKLM\\OFFLINE_SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Image File Execution Options\\sethc.exe\" /v Debugger /t REG_SZ /d \"cmd.exe /k \\\"" + batPath + "\\\"\" /f";
        var rIFEO = RunCmd(ifeoCmd);
        RunCmd("reg unload HKLM\\OFFLINE_SOFTWARE");

        if (rIFEO === 0) {
            steps.push("✓ Options d'ex\u00e9cution (IFEO) configur\u00e9es");
        } else {
            steps.push("✗ Impossible d'injecter la cl\u00e9 IFEO (code " + rIFEO + ")");
            success = false;
        }

        if (success) {
            steps.push("✓ L'ordinateur est pr\u00eat. Retirez la cl\u00e9 et red\u00e9marrez.");
        }
        
        renderResult(success, steps);
    } catch(e) {
        renderResult(false, ["✗ Erreur JS: " + e.message]);
    }
}

function renderResult(success, steps) {
    document.getElementById("result-status").innerHTML = '<div class="label">R\u00e9sultat</div>' +
        (success
            ? '<span class="found" style="font-size:18px;font-weight:700;">\u2713 Pr\u00eat ! Suivez les \u00e9tapes ci-dessous.</span>'
            : '<span class="error" style="font-size:15px;">\u2717 Op\u00e9ration \u00e9chou\u00e9e</span><br>' + steps[steps.length-1]);

    if (success) {
        document.getElementById("btn-reboot").style.display = "block";
        document.getElementById("result-steps").innerHTML =
            '<div class="step-title" style="font-size:15px;margin-bottom:16px;">Prochaines \u00e9tapes</div>' +
            '<div style="font-size:14px;line-height:2.2;color:#e0e0e0;">' +
            '<div>1. \uD83D\uDD0C Retirez la cl\u00e9 USB</div>' +
            '<div>2. \uD83D\uDD04 Red\u00e9marrez le PC</div>' +
            '<div>3. Sur l\'\u00e9cran de login \u2192 appuyez <strong style="color:#5b8def;font-size:16px;">5x sur Maj</strong></div>' +
            '<div>4. Suivez les instructions \u00e0 l\'\u00e9cran</div>' +
            '</div>';
    } else {
        document.getElementById("result-steps").innerHTML =
            '<div class="error" style="font-size:13px;">' + steps.join('<br>') + '</div>';
    }
}

function reboot() {
    var shell = new ActiveXObject("WScript.Shell");
    // Essaie d'abord shutdown (Windows normal), si échec (WinPE) utilise wpeutil
    shell.Run("cmd.exe /c shutdown /r /t 5 || wpeutil reboot", 0, false);
    document.getElementById("result-status").innerHTML = '<div class="label">Red\u00e9marrage</div><span class="info">\u21ba Red\u00e9marrage en cours...</span>';
}
</script>

