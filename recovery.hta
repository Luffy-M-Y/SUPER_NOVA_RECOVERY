<!DOCTYPE html>
<html>
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
<title>SUPER NOVA RECOVERY</title>
<HTA:APPLICATION
    ID="SuperNovaRecovery"
    APPLICATIONNAME="SuperNovaRecovery"
    ICON="SUPER_NOVA.ico"
    BORDER="thin"
    BORDERSTYLE="normal"
    CAPTION="yes"
    MAXIMIZEBUTTON="no"
    MINIMIZEBUTTON="no"
    SHOWINTASKBAR="yes"
    SINGLEINSTANCE="yes"
    SYSMENU="yes"
    WINDOWSTATE="normal"
    SCROLL="no"
    INNERBORDER="no"
/>
<style>
* { margin: 0; padding: 0; box-sizing: border-box; }

html, body {
    height: 100%;
    width: 100%;
    margin: 0;
    padding: 0;
    background: #171717;
}

body {
    color: #f2f2f2;
    font-family: 'Segoe UI', Tahoma, sans-serif;
    overflow: hidden;
    display: table;
    width: 100%;
    height: 100%;
}

#app-wrapper {
    display: table-cell;
    vertical-align: middle;
    text-align: center;
}

#app {
    display: inline-block;
    text-align: left;
    width: 90%;
    max-width: 860px;
    background: #202020;
    border: 1px solid #363636;
    border-radius: 10px;
    padding: 36px 56px;
    box-shadow: 0 12px 35px rgba(0,0,0,0.35);
    overflow-y: auto;
}

.logo { text-align: center; margin-bottom: 30px; }
.logo h1 {
    font-size: 21px;
    font-weight: 600;
    color: #f2f2f2;
    letter-spacing: 1.5px;
    text-transform: uppercase;
}
.logo p {
    font-size: 12px;
    color: #8f8f8f;
    margin-top: 6px;
    letter-spacing: 0.5px;
}

.screen { display: none; }
.screen.active { display: block; }
.hidden { display: none !important; }

.status-box {
    background: #282828;
    border: 1px solid #363636;
    border-radius: 7px;
    padding: 16px 20px;
    margin-bottom: 20px;
    font-size: 13px;
    line-height: 1.8;
    min-height: 80px;
}
.status-box .label {
    color: #858585;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 8px;
}

.found { color: #4caf7d; }
.error { color: #d96c6c; }
.warn  { color: #d6a354; }
.info  { color: #8aaee8; }

.btn {
    width: 100%;
    padding: 13px 14px;
    border: none;
    border-radius: 6px;
    font-family: 'Segoe UI', Tahoma, sans-serif;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.3px;
    cursor: pointer;
    transition: background-color 0.15s ease, border-color 0.15s ease, opacity 0.15s ease;
}
.btn:hover { opacity: 0.9; }
.btn:disabled { opacity: 0.4; cursor: not-allowed; }
.btn-primary { background: #5b8def; color: #fff; }
.btn-primary:hover { background: #6797f2; }
.btn-danger  { background: #b85c5c; color: #fff; }
.btn-danger:hover { background: #c26666; }
.btn-ghost   { background: transparent; color: #a6a6a6; border: 1px solid #3a3a3a; margin-top: 10px; }
.btn-ghost:hover { background: #292929; color: #d8d8d8; }
.btn-invalid { border: 2px solid #fc8181; }

#accounts-list {
    max-height: 220px;
    overflow-y: auto;
    margin-bottom: 14px;
    padding-right: 5px;
}
.account-item {
    background: #282828;
    border: 1px solid #373737;
    border-radius: 6px;
    padding: 12px 16px;
    margin-bottom: 8px;
    cursor: pointer;
    transition: background-color 0.15s ease, border-color 0.15s ease;
    font-size: 13px;
}
.account-item:hover { background: #2d2d2d; border-color: #4a4a4a; }
.account-item.selected { background: #29364d; border-color: #5b8def; }
.account-item .acc-name { font-weight: 600; color: #eeeeee; }
.account-item .acc-type { font-size: 11px; color: #929292; margin-top: 3px; }

.warning-box {
    background: #2b261c;
    border: 1px solid #5b4a2f;
    border-radius: 7px;
    padding: 12px 16px;
    font-size: 12px;
    color: #d6a354;
    margin-bottom: 20px;
    line-height: 1.6;
}
.warning-box strong { color: #e0bd7d; }

.steps {
    background: #282828;
    border: 1px solid #363636;
    border-radius: 7px;
    padding: 16px 20px;
    margin-bottom: 20px;
    font-size: 12px;
    line-height: 2;
    color: #a6a6a6;
}
.steps .step-done { color: #4caf7d; }
.steps .step-title { color: #eeeeee; font-weight: 600; font-size: 13px; margin-bottom: 8px; }
.steps .step-title-lg { font-size: 15px; margin-bottom: 16px; }
.next-steps { font-size: 14px; line-height: 2.2; color: #e0e0e0; }
.hl { color: #5b8def; font-size: 16px; }
.result-ok { font-size: 18px; font-weight: 700; }
.result-fail { font-size: 15px; }
.confirm-name { font-size: 15px; font-weight: 600; color: #e0e0e0; }
.confirm-type { font-size: 12px; color: #8f8f8f; margin-top: 4px; }
.inline-error { color: #d96c6c; font-size: 12px; margin-top: 8px; text-align: center; }

.spinner {
    display: inline-block;
    width: 14px; height: 14px;
    border: 2px solid #3a3a3a;
    border-top-color: #5b8def;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
    vertical-align: middle;
    margin-right: 8px;
}
@keyframes spin { to { transform: rotate(360deg); } }

.section-title {
    font-size: 10px;
    color: #858585;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 12px;
}
</style>
</head>
<body>

<div id="app-wrapper">
<div id="app">
    <div class="logo">
        <h1>⚡ SUPER NOVA RECOVERY</h1>
        <p>Réinitialisation de mot de passe Windows</p>
    </div>

    <div id="screen-detect" class="screen active">
        <div class="status-box">
            <div class="label">Statut de détection</div>
            <div id="detect-status" class="info">
                <span class="spinner"></span> Recherche de la partition Windows...
            </div>
        </div>
        <button class="btn btn-primary" id="btn-detect" onclick="detectWindows()">
            Analyser les disques
        </button>
    </div>

    <div id="screen-windows" class="screen">
        <div class="section-title">Installations Windows détectées</div>
        <div id="windows-list"></div>
        <div id="windows-error" class="inline-error hidden"></div>
        <div class="warning-box">
            ⚠️ Plusieurs installations Windows ont été trouvées. Sélectionnez celle à analyser.
        </div>
        <button class="btn btn-primary" id="btn-windows" onclick="confirmWindowsDrive()" disabled>
            Continuer avec cette partition
        </button>
        <button class="btn btn-ghost" onclick="returnToDetection()">← Retour</button>
    </div>

    <div id="screen-accounts" class="screen">
        <div class="section-title">Comptes détectés sur <span id="drive-label"></span></div>
        <div id="accounts-list"></div>
        <div class="warning-box">
            ⚠️ Fonctionne uniquement avec les comptes locaux.<br>
            Compte Microsoft (@outlook, @hotmail) → <strong>account.live.com</strong>
        </div>
        <button class="btn btn-danger" id="btn-reset" onclick="confirmReset()" disabled>
            🔑 Réinitialiser le mot de passe
        </button>
        <button class="btn btn-ghost" onclick="returnFromAccounts()">← Retour</button>
    </div>

    <div id="screen-confirm" class="screen">
        <div class="status-box">
            <div class="label">Compte sélectionné</div>
            <div id="confirm-account" class="confirm-name"></div>
            <div id="confirm-type" class="confirm-type"></div>
        </div>
        <div class="warning-box">
            ⚠️ Cette opération va modifier des fichiers système Windows.<br>
            Assurez-vous d'avoir l'autorisation d'accéder à ce PC.<br>
            Le déclencheur 5× Maj est à usage unique : il est retiré dès le lancement
            (et à la prochaine connexion si 5× Maj n'est pas utilisé).
        </div>
        <button class="btn btn-danger" onclick="executeReset()">
            ✓ Confirmer la réinitialisation
        </button>
        <button class="btn btn-ghost" onclick="showScreen('screen-accounts')">← Annuler</button>
    </div>

    <div id="screen-result" class="screen">
        <div class="status-box" id="result-status"></div>
        <div class="steps" id="result-steps"></div>
        <button class="btn btn-primary hidden" id="btn-reboot" onclick="reboot()">↺ Redémarrer le PC</button>
        <button class="btn btn-ghost" onclick="showScreen('screen-detect')">Recommencer</button>
    </div>
</div>
</div>

<div id="payload-templates" class="hidden">
<textarea id="tpl-recovery-script">@echo off
reg delete "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Image File Execution Options\sethc.exe" /v Debugger /f >nul 2>&amp;1
color 0F
mode con cols=84 lines=34
title SUPER NOVA RECOVERY
cls
echo =========================================
echo          SUPER NOVA RECOVERY
echo =========================================
echo.
echo Compte cible : {{ACCOUNT}}
echo.
:ASK_PWD
echo Entrez le nouveau mot de passe. Windows vous demandera une confirmation masquee.
echo.
net user "{{ACCOUNT}}" *
if %ERRORLEVEL% EQU 0 goto :SUCCESS
echo.
echo [ERREUR] Les mots de passe ne correspondent pas, sont invalides, ou le compte est Microsoft.
echo 1 - Recommencer la saisie
echo 2 - Compte Microsoft (recuperer mes donnees)
set "pwdChoice="
set /p pwdChoice="Choix : "
if /I "%pwdChoice%"=="2" goto :MS_ACCOUNT
goto :ASK_PWD

:SUCCESS
echo.
echo [SUCCES] Le mot de passe a ete reinitialise !
echo Finalisation en cours...
reg delete "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Image File Execution Options\sethc.exe" /v Debugger /f >nul 2>&amp;1
del "%SystemDrive%\SuperNova_IFEO_debug.log" >nul 2>&amp;1
del "{{SN_FOLDER}}\CopyData.bat" >nul 2>&amp;1
del "{{SN_FOLDER}}\NettoyageFinal.bat" >nul 2>&amp;1
del "{{SN_FOLDER}}\ifeo_launch.bat" >nul 2>&amp;1
start "" /b cmd /c "timeout /t 2 /nobreak >nul &amp; rd /s /q ""{{SN_FOLDER}}"""
echo L'ordinateur va redemarrer dans 10 secondes pour appliquer les changements.
shutdown /r /t 10
pause
goto :CLEANUP

:MS_ACCOUNT
echo.
echo =========================================
echo  COMPTE MICROSOFT DETECTE
echo =========================================
echo.
echo Ce compte est lie a Microsoft.
echo Pour changer le mot de passe, rendez-vous sur :
echo    https://account.live.com/password/reset
echo.
echo Cependant, vous pouvez recuperer vos donnees !
echo.
echo 1 - Recuperer mes donnees (creer un compte de secours)
echo 2 - Quitter
echo.
set /p choice="Choix : "
if "%choice%"=="1" goto :RECOVER
goto :QUIT

:RECOVER
echo.
echo Avant de creer le compte SuperNovaAdmin,
echo definissez un mot de passe obligatoire.
echo Notez-le : il servira a la connexion apres redemarrage.
:SN_ADMIN_PWD
echo.
echo Creation du compte SuperNovaAdmin...
net user SuperNovaAdmin >nul 2>&amp;1
if not errorlevel 1 goto :SN_ADMIN_EXISTS
net user SuperNovaAdmin * /add
if errorlevel 1 (
    echo [ERREUR] Creation impossible. Le mot de passe ne respecte peut-etre pas la politique Windows.
    goto :SN_ADMIN_PWD
)
net localgroup Administrateurs SuperNovaAdmin /add >nul 2>&amp;1
net localgroup Administrators SuperNovaAdmin /add >nul 2>&amp;1
echo [OK] Compte SuperNovaAdmin cree avec succes.
echo.
echo Preparation de l'outil de transfert...
mkdir "{{WIN_DRIVE}}:\ProgramData\SuperNova" 2>nul
copy /Y "{{SN_FOLDER}}\CopyData.bat" "%public%\Desktop\CopyData.bat" >nul
copy /Y "{{SN_FOLDER}}\NettoyageFinal.bat" "{{WIN_DRIVE}}:\ProgramData\SuperNova\NettoyageFinal.bat" >nul
echo [OK] Outil de finalisation genere.
echo.
echo [OK] Outil de transfert installe sur le Bureau.
echo.
echo =========================================
echo  PROCHAINES ETAPES :
echo =========================================
echo 1. Le PC va redemarrer automatiquement.
echo 2. Connectez-vous au compte "SuperNovaAdmin" avec le mot de passe defini.
echo 3. Lancez "CopyData" sur le Bureau.
echo 4. Vos fichiers seront transferes.
echo.
reg delete "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Image File Execution Options\sethc.exe" /v Debugger /f >nul 2>&amp;1
echo Redemarrage dans 15 secondes...
shutdown /r /t 15
timeout /t 14 /nobreak >nul
goto :CLEANUP

:SN_ADMIN_EXISTS
echo.
echo [ERREUR] Le compte SuperNovaAdmin existe deja.
echo Aucun mot de passe n'a ete modifie pour proteger ce compte existant.
echo Utilisez ce compte s'il est deja connu, ou supprimez-le avant de relancer cette operation.
pause
goto :QUIT

:QUIT
echo.
echo Vous avez choisi de quitter.
echo L'ordinateur va redemarrer dans 10 secondes...
reg delete "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Image File Execution Options\sethc.exe" /v Debugger /f >nul 2>&amp;1
shutdown /r /t 10
timeout /t 4 /nobreak >nul
goto :CLEANUP

:CLEANUP
(goto) 2>nul &amp; del "%~f0"
start "" /b cmd /c "timeout /t 2 /nobreak >nul &amp; rd /s /q ""{{SN_FOLDER}}"""
</textarea>
<textarea id="tpl-copy-data">@echo off
color 0F
mode con cols=84 lines=34
title SUPER NOVA - Recuperation de donnees
cls
fsutil dirty query %systemdrive% >nul
if %errorLevel% NEQ 0 (
    echo Demande d'autorisation...
    powershell -Command "Start-Process -FilePath cmd.exe -ArgumentList @('/k', '\"%~f0\"') -Verb RunAs"
    exit /b
)
echo =========================================
echo    SUPER NOVA - Recuperation de donnees
echo =========================================
echo.
echo Copie de vos fichiers en cours...
echo.
mkdir "{{WIN_DRIVE}}:\Backup_{{ACCOUNT}}" 2>nul
robocopy "{{WIN_DRIVE}}:\Users\{{ACCOUNT}}\Desktop" "{{WIN_DRIVE}}:\Backup_{{ACCOUNT}}\Bureau" /E /MT:8 /R:1 /W:1 /NP
if errorlevel 8 goto :COPY_ERROR
robocopy "{{WIN_DRIVE}}:\Users\{{ACCOUNT}}\Documents" "{{WIN_DRIVE}}:\Backup_{{ACCOUNT}}\Documents" /E /MT:8 /R:1 /W:1 /NP
if errorlevel 8 goto :COPY_ERROR
robocopy "{{WIN_DRIVE}}:\Users\{{ACCOUNT}}\Pictures" "{{WIN_DRIVE}}:\Backup_{{ACCOUNT}}\Images" /E /MT:8 /R:1 /W:1 /NP
if errorlevel 8 goto :COPY_ERROR
robocopy "{{WIN_DRIVE}}:\Users\{{ACCOUNT}}\Downloads" "{{WIN_DRIVE}}:\Backup_{{ACCOUNT}}\Telechargements" /E /MT:8 /R:1 /W:1 /NP
if errorlevel 8 goto :COPY_ERROR
robocopy "{{WIN_DRIVE}}:\Users\{{ACCOUNT}}\Videos" "{{WIN_DRIVE}}:\Backup_{{ACCOUNT}}\Videos" /E /MT:8 /R:1 /W:1 /NP
if errorlevel 8 goto :COPY_ERROR
echo.
echo =========================================
echo  COPIE TERMINEE !
echo =========================================
echo.
if exist "{{WIN_DRIVE}}:\Backup_{{ACCOUNT}}\Bureau" (
    echo [SUCCES] La sauvegarde a reussi !
    echo Vos fichiers sont prets pour le transfert final.
) else (
    echo [ERREUR] La sauvegarde a echoue ou aucun fichier n'a ete copie.
    echo Si vous n'avez pas accepte la demande d'autorisation,
    echo veuillez relancer le programme.
    pause
    exit /b
)
echo.
echo ========================================================
echo Voulez-vous creer un NOUVEAU compte permanent pour utiliser ce PC ? (O/N)
set /p createAccount="Choix : "
if /I "%createAccount%"=="O" goto :CREATE_ACCOUNT
if /I "%createAccount%"=="N" goto :KEEP_ADMIN
goto :END_SCRIPT

:CREATE_ACCOUNT
echo.
set "newUser="
set /p "newUser=Nom du nouveau compte : "
powershell -NoProfile -Command "$u=$env:newUser; if ($u -notmatch '^[A-Za-z0-9._-]{1,20}$') { exit 1 }"
if errorlevel 1 (
    echo [ERREUR] Nom invalide. Utilisez 1 a 20 caracteres : lettres, chiffres, point, tiret ou underscore.
    goto :CREATE_ACCOUNT
)
echo Entrez le mot de passe. Windows demandera une confirmation masquee.
net user "%newUser%" * /add
if errorlevel 1 (
    echo [ERREUR] Creation impossible. Verifiez le nom et la complexite du mot de passe.
    goto :CREATE_ACCOUNT
)
net localgroup Administrateurs "%newUser%" /add >nul 2>&amp;1
net localgroup Administrators "%newUser%" /add >nul 2>&amp;1
echo [OK] Le compte %newUser% a ete cree avec succes et est Administrateur !
echo.
echo [OK] Outil de finalisation prepare.
copy "{{WIN_DRIVE}}:\ProgramData\SuperNova\NettoyageFinal.bat" "{{WIN_DRIVE}}:\Users\Default\Desktop\NettoyageFinal.bat" >nul 2>&amp;1
echo.
echo ========================================================
echo FELICITATIONS ! Votre nouveau compte a ete cree.
echo.
echo Le PC va redemarrer dans 15 secondes.
echo 1. Connectez-vous avec votre nouveau compte.
echo 2. Double-cliquez sur "NettoyageFinal" sur le bureau.
echo 3. Lancez l'outil de finalisation.
echo ========================================================
shutdown /r /t 15
timeout /t 14 /nobreak >nul
reg add "HKLM\Software\Microsoft\Windows\CurrentVersion\RunOnce" /v SNCleanupCopyData /t REG_SZ /d "cmd.exe /c del \"%~f0\"" /f >nul 2>&amp;1
pause
exit

:KEEP_ADMIN
echo.
echo Vous avez choisi de garder le compte SuperNovaAdmin.
echo Transfert des donnees vers vos dossiers personnels...
robocopy "{{WIN_DRIVE}}:\Backup_{{ACCOUNT}}\Bureau" "%USERPROFILE%\Desktop" /E /MOVE /IS /R:1 /W:1 >nul 2>&amp;1
if errorlevel 8 goto :COPY_ERROR
robocopy "{{WIN_DRIVE}}:\Backup_{{ACCOUNT}}\Documents" "%USERPROFILE%\Documents" /E /MOVE /IS /R:1 /W:1 >nul 2>&amp;1
if errorlevel 8 goto :COPY_ERROR
robocopy "{{WIN_DRIVE}}:\Backup_{{ACCOUNT}}\Images" "%USERPROFILE%\Pictures" /E /MOVE /IS /R:1 /W:1 >nul 2>&amp;1
if errorlevel 8 goto :COPY_ERROR
robocopy "{{WIN_DRIVE}}:\Backup_{{ACCOUNT}}\Telechargements" "%USERPROFILE%\Downloads" /E /MOVE /IS /R:1 /W:1 >nul 2>&amp;1
if errorlevel 8 goto :COPY_ERROR
robocopy "{{WIN_DRIVE}}:\Backup_{{ACCOUNT}}\Videos" "%USERPROFILE%\Videos" /E /MOVE /IS /R:1 /W:1 >nul 2>&amp;1
if errorlevel 8 goto :COPY_ERROR
rd /s /q "{{WIN_DRIVE}}:\Backup_{{ACCOUNT}}" >nul 2>&amp;1
echo [OK] Transfert termine avec succes !
echo.
rd /s /q "{{WIN_DRIVE}}:\ProgramData\SuperNova" >nul 2>&amp;1
del "%SystemDrive%\SuperNova_IFEO_debug.log" >nul 2>&amp;1
set "_self=%~f0"
reg add "HKLM\Software\Microsoft\Windows\CurrentVersion\RunOnce" /v SNCleanupCopyData /t REG_SZ /d "cmd.exe /c del \"%_self%\"" /f >nul 2>&amp;1
reg add "HKLM\Software\Microsoft\Windows\CurrentVersion\RunOnce" /v SNCleanupFolder /t REG_SZ /d "cmd.exe /c rd /s /q {{SN_FOLDER}}" /f >nul 2>&amp;1
start "" /b cmd /c "timeout /t 2 /nobreak >nul &amp; rd /s /q ""{{SN_FOLDER}}"""
echo Le PC va redemarrer dans 15 secondes...
shutdown /r /t 15
timeout /t 14 /nobreak >nul
pause
exit

:END_SCRIPT
reg add "HKLM\Software\Microsoft\Windows\CurrentVersion\RunOnce" /v SNCleanupCopyData /t REG_SZ /d "cmd.exe /c del \"%~f0\"" /f >nul 2>&amp;1
exit

:COPY_ERROR
echo.
echo [ERREUR] La copie des donnees a echoue (code Robocopy 8 ou superieur).
echo La sauvegarde est conservee. Corrigez le probleme puis relancez l'outil.
pause
goto :END_SCRIPT
</textarea>
<textarea id="tpl-nettoyage">@echo off
color 0F
mode con cols=84 lines=34
title SUPER NOVA - Nettoyage Final
cls
fsutil dirty query %systemdrive% >nul
if %errorLevel% NEQ 0 (
    echo Demande d'autorisation...
    powershell -Command "Start-Process '%~f0' -Verb RunAs"
    exit /b
)
echo =========================================
echo    SUPER NOVA - Finalisation
echo =========================================
echo.
echo Voulez-vous supprimer le compte temporaire SuperNovaAdmin ? (O/N)
set /p clean="Choix : "
if /I "%clean%"=="O" goto :DO_CLEAN
goto :SKIP_CLEAN
:DO_CLEAN
echo.
echo Transfert des donnees vers votre nouveau compte...
robocopy "{{WIN_DRIVE}}:\Backup_{{ACCOUNT}}\Bureau" "%USERPROFILE%\Desktop" /E /MOVE /IS /R:1 /W:1 >nul 2>&amp;1
if errorlevel 8 goto :COPY_ERROR
robocopy "{{WIN_DRIVE}}:\Backup_{{ACCOUNT}}\Documents" "%USERPROFILE%\Documents" /E /MOVE /IS /R:1 /W:1 >nul 2>&amp;1
if errorlevel 8 goto :COPY_ERROR
robocopy "{{WIN_DRIVE}}:\Backup_{{ACCOUNT}}\Images" "%USERPROFILE%\Pictures" /E /MOVE /IS /R:1 /W:1 >nul 2>&amp;1
if errorlevel 8 goto :COPY_ERROR
robocopy "{{WIN_DRIVE}}:\Backup_{{ACCOUNT}}\Telechargements" "%USERPROFILE%\Downloads" /E /MOVE /IS /R:1 /W:1 >nul 2>&amp;1
if errorlevel 8 goto :COPY_ERROR
robocopy "{{WIN_DRIVE}}:\Backup_{{ACCOUNT}}\Videos" "%USERPROFILE%\Videos" /E /MOVE /IS /R:1 /W:1 >nul 2>&amp;1
if errorlevel 8 goto :COPY_ERROR
rd /s /q "{{WIN_DRIVE}}:\Backup_{{ACCOUNT}}" >nul 2>&amp;1
echo [OK] Transfert termine avec succes !
echo.
echo Suppression du compte SuperNovaAdmin...
net user SuperNovaAdmin /delete >nul 2>&amp;1
rd /s /q "{{WIN_DRIVE}}:\Users\SuperNovaAdmin" >nul 2>&amp;1
rd /s /q "{{WIN_DRIVE}}:\ProgramData\SuperNova" >nul 2>&amp;1
del "{{WIN_DRIVE}}:\Users\Default\Desktop\NettoyageFinal.bat" >nul 2>&amp;1
del "%SystemDrive%\SuperNova_IFEO_debug.log" >nul 2>&amp;1
reg add "HKLM\Software\Microsoft\Windows\CurrentVersion\RunOnce" /v SNCleanupNettoyage /t REG_SZ /d "cmd.exe /c del \"%~f0\"" /f >nul 2>&amp;1
reg add "HKLM\Software\Microsoft\Windows\CurrentVersion\RunOnce" /v SNCleanupFolder /t REG_SZ /d "cmd.exe /c rd /s /q {{SN_FOLDER}}" /f >nul 2>&amp;1
start "" /b cmd /c "timeout /t 2 /nobreak >nul &amp; rd /s /q ""{{SN_FOLDER}}"""
echo.
echo [OK] Compte SuperNovaAdmin supprime avec succes !
echo.
echo Vos donnees ont ete deplacees dans vos dossiers personnels.
echo.
echo Le PC va redemarrer dans 15 secondes pour appliquer les modifications.
shutdown /r /t 15
del "%public%\Desktop\CopyData.bat" >nul 2>&amp;1
timeout /t 14 /nobreak >nul
exit
:SKIP_CLEAN
echo.
echo Vous avez choisi de CONSERVER le compte SuperNovaAdmin.
echo Transfert des donnees vers le compte SuperNovaAdmin...
robocopy "{{WIN_DRIVE}}:\Backup_{{ACCOUNT}}\Bureau" "{{WIN_DRIVE}}:\Users\SuperNovaAdmin\Desktop" /E /MOVE /IS /R:1 /W:1 >nul 2>&amp;1
if errorlevel 8 goto :COPY_ERROR
robocopy "{{WIN_DRIVE}}:\Backup_{{ACCOUNT}}\Documents" "{{WIN_DRIVE}}:\Users\SuperNovaAdmin\Documents" /E /MOVE /IS /R:1 /W:1 >nul 2>&amp;1
if errorlevel 8 goto :COPY_ERROR
robocopy "{{WIN_DRIVE}}:\Backup_{{ACCOUNT}}\Images" "{{WIN_DRIVE}}:\Users\SuperNovaAdmin\Pictures" /E /MOVE /IS /R:1 /W:1 >nul 2>&amp;1
if errorlevel 8 goto :COPY_ERROR
robocopy "{{WIN_DRIVE}}:\Backup_{{ACCOUNT}}\Telechargements" "{{WIN_DRIVE}}:\Users\SuperNovaAdmin\Downloads" /E /MOVE /IS /R:1 /W:1 >nul 2>&amp;1
if errorlevel 8 goto :COPY_ERROR
robocopy "{{WIN_DRIVE}}:\Backup_{{ACCOUNT}}\Videos" "{{WIN_DRIVE}}:\Users\SuperNovaAdmin\Videos" /E /MOVE /IS /R:1 /W:1 >nul 2>&amp;1
if errorlevel 8 goto :COPY_ERROR
rd /s /q "{{WIN_DRIVE}}:\Backup_{{ACCOUNT}}" >nul 2>&amp;1
echo [OK] Transfert termine avec succes !
echo.
echo Le compte SuperNovaAdmin a deja un mot de passe.
echo Saisissez-le a nouveau, ou choisissez-en un autre.
:PWD_LOOP2
echo Entrez le nouveau mot de passe. Windows demandera une confirmation masquee.
net user SuperNovaAdmin *
if errorlevel 1 goto :PWD_LOOP2
echo [OK] Mot de passe enregistre.
echo.
rd /s /q "{{WIN_DRIVE}}:\ProgramData\SuperNova" >nul 2>&amp;1
del "{{WIN_DRIVE}}:\Users\Default\Desktop\NettoyageFinal.bat" >nul 2>&amp;1
del "%SystemDrive%\SuperNova_IFEO_debug.log" >nul 2>&amp;1
reg add "HKLM\Software\Microsoft\Windows\CurrentVersion\RunOnce" /v SNCleanupNettoyage /t REG_SZ /d "cmd.exe /c del \"%~f0\"" /f >nul 2>&amp;1
reg add "HKLM\Software\Microsoft\Windows\CurrentVersion\RunOnce" /v SNCleanupFolder /t REG_SZ /d "cmd.exe /c rd /s /q {{SN_FOLDER}}" /f >nul 2>&amp;1
start "" /b cmd /c "timeout /t 2 /nobreak >nul &amp; rd /s /q ""{{SN_FOLDER}}"""
echo Le PC va redemarrer dans 15 secondes pour appliquer les modifications.
shutdown /r /t 15
timeout /t 14 /nobreak >nul
exit

:COPY_ERROR
echo.
echo [ERREUR] Le transfert des donnees a echoue (code Robocopy 8 ou superieur).
echo La sauvegarde est conservee. Corrigez le probleme puis relancez NettoyageFinal.
pause
exit
</textarea>
</div>

<script language="VBScript">
Function RunCmd(cmd)
    Dim shell
    Set shell = CreateObject("WScript.Shell")
    RunCmd = shell.Run("cmd.exe /c " & cmd, 0, True)
End Function

Function RunCmdOutput(cmd)
    Dim shell, exec
    Set shell = CreateObject("WScript.Shell")
    Set exec = shell.Exec("cmd.exe /c " & cmd)
    RunCmdOutput = exec.StdOut.ReadAll()
End Function

Function FileExists(path)
    Dim fso
    Set fso = CreateObject("Scripting.FileSystemObject")
    FileExists = fso.FileExists(path)
End Function

Function FindWindowsDrives()
    Dim d, code, candidates, shell, peDrive
    candidates = ""
    Set shell = CreateObject("WScript.Shell")
    peDrive = UCase(Left(shell.ExpandEnvironmentStrings("%SystemDrive%"), 1))
    For code = Asc("C") To Asc("Z")
        d = Chr(code)
        If d <> peDrive And FileExists(d & ":\Windows\System32\config\SAM") Then
            If candidates <> "" Then candidates = candidates & "|"
            candidates = candidates & d
        End If
    Next
    FindWindowsDrives = candidates
End Function

Function GetAccounts(winDrive)
    Dim output, lines, i, acc
    RunCmd "reg unload HKLM\OFFLINE_SAM"
    RunCmd "reg load HKLM\OFFLINE_SAM """ & winDrive & ":\Windows\System32\config\SAM"""
    output = RunCmdOutput("reg query ""HKLM\OFFLINE_SAM\SAM\Domains\Account\Users\Names""")
    lines = Split(output, vbCrLf)
    Dim accounts()
    Dim count : count = 0

    For i = 0 To UBound(lines)
        Dim line : line = Trim(lines(i))
        If Left(line, 4) = "HKEY" Then
            Dim parts : parts = Split(line, "\")
            acc = parts(UBound(parts))
            If acc <> "" And acc <> "Names" Then
                ReDim Preserve accounts(count)
                accounts(count) = acc
                count = count + 1
            End If
        End If
    Next

    RunCmd "reg unload HKLM\OFFLINE_SAM"

    If count = 0 Then
        GetAccounts = ""
    Else
        GetAccounts = Join(accounts, "|")
    End If
End Function

Function IsBitLockerLocked(winDrive)
    Dim output, normalized
    output = RunCmdOutput("manage-bde -status " & winDrive & ": 2>&1")
    normalized = LCase(output)
    IsBitLockerLocked = (InStr(normalized, "lock status: locked") > 0) _
        Or (InStr(normalized, "lock status : locked") > 0) _
        Or (InStr(normalized, "verrouillage : verrouillé") > 0) _
        Or (InStr(normalized, "verrouillage: verrouillé") > 0) _
        Or (InStr(normalized, "verrouillage : verrouille") > 0) _
        Or (InStr(normalized, "verrouillage: verrouille") > 0)
End Function

Function FindLockedBitLockerDrives()
    Dim d, code, result, shell, peDrive
    result = ""
    Set shell = CreateObject("WScript.Shell")
    peDrive = UCase(Left(shell.ExpandEnvironmentStrings("%SystemDrive%"), 1))
    For code = Asc("C") To Asc("Z")
        d = Chr(code)
        If d <> peDrive And IsBitLockerLocked(d) Then
            If result <> "" Then result = result & "|"
            result = result & d
        End If
    Next
    FindLockedBitLockerDrives = result
End Function
</script>

<script language="JavaScript">
window.onerror = function(msg, url, line) {
    setDetectStatus('<span class="error">✗ ERREUR CRITIQUE : ' + msg + ' (ligne ' + line + ')</span>');
    return true;
};

var selectedAccount = "";
var windowsDrive = "";
var selectedWindowsDrive = "";
var detectedWindowsDrives = [];
var accounts = [];
var screenIds = ["screen-detect", "screen-windows", "screen-accounts", "screen-confirm", "screen-result"];

function byId(id) {
    return document.getElementById(id);
}

function isBuiltinAdmin(name) {
    var n = String(name).toLowerCase();
    return n === "administrateur" || n === "administrator";
}

function isSystemAccount(name) {
    var n = String(name).toLowerCase();
    return n === "administrateur" || n === "administrator" ||
        n === "invit\u00e9" || n === "invite" || n === "guest" ||
        n === "defaultaccount" || n === "wdagutilityaccount" || n === "wsiaccount";
}

function isSafeAccountName(name) {
    var s = String(name);
    if (!s || s.length > 64) return false;
    return /^[a-zA-Z0-9 _\-\.àâäéèêëîïôùûüçÀÂÄÉÈÊËÎÏÔÙÛÜÇ]{1,64}$/.test(s);
}

function accountTypeLabel(name) {
    return isBuiltinAdmin(name) ? "Administrateur int\u00e9gr\u00e9" : "Compte Windows";
}

function escapeHtml(s) {
    return String(s)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;");
}

function clearAccountError() {
    var err = byId("no-account-error");
    if (err) err.parentNode.removeChild(err);
    byId("btn-reset").className = "btn btn-danger";
}

function showScreen(id) {
    for (var i = 0; i < screenIds.length; i++) {
        byId(screenIds[i]).className = "screen";
    }
    byId(id).className = "screen active";
    if (id === "screen-accounts") {
        selectedAccount = "";
        byId("btn-reset").disabled = true;
        clearAccountError();
    }
}

function setDetectStatus(html) {
    byId("detect-status").innerHTML = html;
}

window.onload = function() {
    var w = Math.round(screen.width * 0.75);
    var h = Math.round(screen.height * 0.80);
    window.resizeTo(w, h);
    window.moveTo(
        Math.round((screen.width - w) / 2),
        Math.round((screen.height - h) / 2)
    );
    byId("app").style.maxHeight = Math.round(h * 0.88) + "px";
    byId("accounts-list").style.maxHeight = Math.round(h * 0.30) + "px";
    setTimeout(detectWindows, 500);
};

function detectWindows() {
    setDetectStatus('<span class="spinner"></span> Recherche en cours...');
    try {
        var rawDrives = FindWindowsDrives();
        if (rawDrives === "") {
            var lockedDrives = FindLockedBitLockerDrives();
            if (lockedDrives !== "") {
                var lockedLabel = lockedDrives.split("|").join(":\\, ") + ":\\";
                setDetectStatus('<span class="warn">\u26a0 Partition BitLocker verrouill\u00e9e d\u00e9tect\u00e9e sur ' + escapeHtml(lockedLabel) + '. D\u00e9verrouillez-la avec votre cl\u00e9 de r\u00e9cup\u00e9ration, puis relancez l\'analyse.</span>');
            } else {
                setDetectStatus('<span class="error">\u2717 Partition Windows introuvable.</span>');
            }
            return;
        }
        var drives = rawDrives.split("|");
        detectedWindowsDrives = drives;
        if (drives.length === 1) {
            openWindowsDrive(drives[0]);
            return;
        }
        renderWindowsDrives(drives);
        showScreen("screen-windows");
    } catch (e) {
        setDetectStatus('<span class="error">\u2717 Erreur : ' + e.message + '</span>');
    }
}

function renderWindowsDrives(drives) {
    var list = byId("windows-list");
    list.innerHTML = "";
    selectedWindowsDrive = "";
    byId("btn-windows").disabled = true;
    for (var i = 0; i < drives.length; i++) {
        var drive = drives[i];
        var div = document.createElement("div");
        div.className = "account-item";
        div.setAttribute("data-drive", drive);
        div.innerHTML = '<div class="acc-name">\ud83d\uddb4\ufe0f Windows sur ' + escapeHtml(drive) + ':\\</div>' +
            '<div class="acc-type">Partition contenant les fichiers syst\u00e8me Windows</div>';
        div.onclick = function() { selectWindowsDrive(this); };
        list.appendChild(div);
    }
}

function selectWindowsDrive(el) {
    var choices = byId("windows-list").children;
    for (var i = 0; i < choices.length; i++) {
        choices[i].className = "account-item";
    }
    el.className = "account-item selected";
    selectedWindowsDrive = el.getAttribute("data-drive");
    byId("btn-windows").disabled = false;
    clearWindowsError();
}

function confirmWindowsDrive() {
    if (selectedWindowsDrive !== "") openWindowsDrive(selectedWindowsDrive);
}

function clearWindowsError() {
    var error = byId("windows-error");
    error.className = "inline-error hidden";
    error.innerHTML = "";
}

function showWindowsError(message) {
    var error = byId("windows-error");
    error.className = "inline-error";
    error.textContent = message;
}

function returnToDetection() {
    selectedWindowsDrive = "";
    showScreen("screen-detect");
    setDetectStatus('<span class="info">Choisissez « Analyser les disques » pour relancer la recherche.</span>');
}

function returnFromAccounts() {
    if (detectedWindowsDrives.length > 1) {
        renderWindowsDrives(detectedWindowsDrives);
        showScreen("screen-windows");
        return;
    }
    returnToDetection();
}

function openWindowsDrive(drive) {
    windowsDrive = drive;
    try {
        if (IsBitLockerLocked(drive)) {
            showScreen("screen-detect");
            setDetectStatus('<span class="warn">\u26a0 Partition BitLocker verrouill\u00e9e sur ' + drive + ':\\. D\u00e9verrouillez-la avec votre cl\u00e9 de r\u00e9cup\u00e9ration, puis relancez l\'analyse.</span>');
            return;
        }
        setDetectStatus('<span class="found">\u2713 Windows trouv\u00e9 sur ' + drive + ':\\</span>');
        loadAccounts(drive);
    } catch (e) {
        setDetectStatus('<span class="error">\u2717 Erreur : ' + e.message + '</span>');
    }
}

function loadAccounts(drive) {
    try {
        var rawString = GetAccounts(drive);
        accounts = [];
        if (rawString !== "") {
            var splitted = rawString.split("|");
            for (var i = 0; i < splitted.length; i++) {
                if (splitted[i] !== "" && !isSystemAccount(splitted[i])) accounts.push(splitted[i]);
            }
        }
        if (accounts.length === 0) {
            if (detectedWindowsDrives.length > 1) {
                showWindowsError("Aucun compte local personnel trouv\u00e9 sur " + drive + ":\\. S\u00e9lectionnez une autre installation Windows.");
                showScreen("screen-windows");
            } else {
                showScreen("screen-detect");
                setDetectStatus('<span class="warn">\u26a0 Aucun compte local personnel trouv\u00e9 sur ' + drive + ':\\</span>');
            }
            return;
        }
        byId("drive-label").textContent = drive + ":\\Windows";
        renderAccounts();
        showScreen("screen-accounts");
    } catch (e) {
        setDetectStatus('<span class="error">\u2717 SAM illisible : ' + e.message + '</span>');
    }
}

function renderAccounts() {
    var list = byId("accounts-list");
    list.innerHTML = "";
    for (var i = 0; i < accounts.length; i++) {
        var name = accounts[i];
        var div = document.createElement("div");
        div.className = "account-item";
        div.setAttribute("data-name", name);
        div.innerHTML = '<div class="acc-name">\uD83D\uDC64 ' + escapeHtml(name) +
            '</div><div class="acc-type">' + accountTypeLabel(name) + '</div>';
        div.onclick = function() { selectAccount(this); };
        list.appendChild(div);
    }
}

function selectAccount(el) {
    var kids = byId("accounts-list").children;
    for (var i = 0; i < kids.length; i++) {
        kids[i].className = "account-item";
    }
    el.className = "account-item selected";
    selectedAccount = el.getAttribute("data-name");
    byId("btn-reset").disabled = false;
    clearAccountError();
}

function confirmReset() {
    if (!selectedAccount) {
        byId("btn-reset").className = "btn btn-danger btn-invalid";
        if (!byId("no-account-error")) {
            var err = document.createElement("div");
            err.id = "no-account-error";
            err.className = "inline-error";
            err.textContent = "\u26a0 Veuillez s\u00e9lectionner un compte avant de continuer.";
            byId("btn-reset").parentNode.insertBefore(err, byId("btn-reset").nextSibling);
        }
        return;
    }
    if (!isSafeAccountName(selectedAccount)) {
        byId("btn-reset").className = "btn btn-danger btn-invalid";
        if (!byId("no-account-error")) {
            var err = document.createElement("div");
            err.id = "no-account-error";
            err.className = "inline-error";
            err.textContent = "\u26a0 Nom de compte invalide. Selectionnez un autre compte.";
            byId("btn-reset").parentNode.insertBefore(err, byId("btn-reset").nextSibling);
        }
        return;
    }
    byId("confirm-account").innerHTML = "&#128100; " + escapeHtml(selectedAccount);
    byId("confirm-type").innerHTML = isBuiltinAdmin(selectedAccount)
        ? "Administrateur int\u00e9gr\u00e9"
        : "Compte Windows \u2014 " + windowsDrive + ":\\Windows";
    showScreen("screen-confirm");
}

function fillTemplate(id, account, snFolder) {
    return byId(id).value
        .replace(/\{\{ACCOUNT\}\}/g, account)
        .replace(/\{\{SN_FOLDER\}\}/g, snFolder)
        .replace(/\{\{WIN_DRIVE\}\}/g, "C");
}

function ensureFolder(path) {
    var fso = new ActiveXObject("Scripting.FileSystemObject");
    if (!fso.FolderExists(path)) fso.CreateFolder(path);
}

function writeTextFile(path, content) {
    var fso = new ActiveXObject("Scripting.FileSystemObject");
    var file = fso.CreateTextFile(path, true);
    file.Write(content);
    file.Close();
}

function executeReset() {
    showScreen("screen-result");
    byId("result-status").innerHTML = '<div class="label">Op\u00e9ration en cours</div><span class="spinner"></span> Application des modifications...';
    byId("result-steps").innerHTML = "";
    byId("btn-reboot").className = "btn btn-primary hidden";
    try {
        if (!isSafeAccountName(selectedAccount)) {
            renderResult(false, ["\u2717 Nom de compte invalide."]);
            return;
        }
        var peFolder = windowsDrive + ":\\SuperNova";
        var bootFolder = "C:\\SuperNova";
        var steps = [];
        var success = true;

        ensureFolder(peFolder);
        writeTextFile(peFolder + "\\recovery_script.bat", fillTemplate("tpl-recovery-script", selectedAccount, bootFolder));
        writeTextFile(peFolder + "\\CopyData.bat", fillTemplate("tpl-copy-data", selectedAccount, bootFolder));
        writeTextFile(peFolder + "\\NettoyageFinal.bat", fillTemplate("tpl-nettoyage", selectedAccount, bootFolder));
        writeTextFile(peFolder + "\\ifeo_launch.bat",
            "@echo off\r\n" +
            "set \"SN_LOG=%SystemDrive%\\SuperNova_IFEO_debug.log\"\r\n" +
            "> \"%SN_LOG%\" echo ==== SUPER NOVA IFEO %DATE% %TIME% ====\r\n" +
            ">> \"%SN_LOG%\" echo Lanceur demarre sous %USERNAME%.\r\n" +
            "reg delete \"HKLM\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Image File Execution Options\\sethc.exe\" /v Debugger /f >nul 2>&1\r\n" +
            ">> \"%SN_LOG%\" echo Declencheur IFEO retire.\r\n" +
            "if not exist \"%~dp0recovery_script.bat\" goto :MISSING\r\n" +
            ">> \"%SN_LOG%\" echo Lancement de recovery_script.bat dans la console partagee.\r\n" +
            "start \"\" /b cmd.exe /d /k call \"%~dp0recovery_script.bat\"\r\n" +
            ">> \"%SN_LOG%\" echo Console de recuperation lancee.\r\n" +
            "exit\r\n" +
            ":MISSING\r\n" +
            ">> \"%SN_LOG%\" echo ERREUR: recovery_script.bat introuvable.\r\n" +
            "echo Script de recuperation introuvable.\r\n" +
            "echo Le declencheur SYSTEM IFEO a ete retire.\r\n" +
            "pause\r\n");
        steps.push("\u2713 Script de r\u00e9initialisation g\u00e9n\u00e9r\u00e9");

        var aclCmd = "icacls \"" + peFolder + "\" /inheritance:r /grant:r *S-1-5-18:(OI)(CI)F *S-1-5-32-544:(OI)(CI)F *S-1-5-32-545:(OI)(CI)RX";
        var rAcl = RunCmd(aclCmd);
        if (rAcl !== 0) {
            renderResult(false, ["\u2717 Impossible de prot\u00e9ger le dossier des scripts (code " + rAcl + "). Le d\u00e9clencheur n'a pas \u00e9t\u00e9 activ\u00e9."]);
            return;
        }
        var rAclVerify = RunCmd("icacls \"" + peFolder + "\" /verify");
        if (rAclVerify !== 0) {
            renderResult(false, ["\u2717 Les permissions du dossier sont invalides (code " + rAclVerify + "). Le d\u00e9clencheur n'a pas \u00e9t\u00e9 activ\u00e9."]);
            return;
        }
        steps.push("\u2713 Dossier des scripts verrouill\u00e9 (lecture seule pour les utilisateurs standard)");
        steps.push("\u2713 Permissions du dossier v\u00e9rifi\u00e9es");

        var backupFolder = peFolder + "\\Backup";
        ensureFolder(backupFolder);
        var backupAclCmd = "icacls \"" + backupFolder + "\" /inheritance:r /grant:r *S-1-5-18:(OI)(CI)F *S-1-5-32-544:(OI)(CI)F";
        var rBackupAcl = RunCmd(backupAclCmd);
        if (rBackupAcl !== 0) {
            renderResult(false, ["\u2717 Impossible de prot\u00e9ger la sauvegarde des ruches (code " + rBackupAcl + "). L'op\u00e9ration est interrompue."]);
            return;
        }
        var rBackupVerify = RunCmd("icacls \"" + backupFolder + "\" /verify");
        if (rBackupVerify !== 0) {
            renderResult(false, ["\u2717 Les permissions de la sauvegarde sont invalides (code " + rBackupVerify + "). L'op\u00e9ration est interrompue."]);
            return;
        }
        var hives = ["SAM", "SYSTEM", "SECURITY"];
        for (var h = 0; h < hives.length; h++) {
            var hive = hives[h];
            var sourceHive = windowsDrive + ":\\Windows\\System32\\config\\" + hive;
            var targetHive = backupFolder + "\\" + hive;
            var rBackup = RunCmd("copy /Y \"" + sourceHive + "\" \"" + targetHive + "\"");
            if (rBackup !== 0) {
                renderResult(false, ["\u2717 Sauvegarde de la ruche " + hive + " impossible (code " + rBackup + "). L'op\u00e9ration est interrompue avant toute modification."]);
                return;
            }
        }
        steps.push("\u2713 Sauvegarde prot\u00e9g\u00e9e des ruches SAM, SYSTEM et SECURITY");

        RunCmd("reg unload HKLM\\OFFLINE_SOFTWARE");
        var rLoadSoftware = RunCmd("reg load HKLM\\OFFLINE_SOFTWARE \"" + windowsDrive + ":\\Windows\\System32\\config\\SOFTWARE\"");
        if (rLoadSoftware !== 0) {
            renderResult(false, ["\u2717 Impossible de charger le registre SOFTWARE (code " + rLoadSoftware + "). Aucune modification n'a \u00e9t\u00e9 appliqu\u00e9e."]);
            return;
        }
        var launchPath = bootFolder + "\\ifeo_launch.bat";
        var ifeoCmd = "reg add \"HKLM\\OFFLINE_SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Image File Execution Options\\sethc.exe\" /v Debugger /t REG_SZ /d \"cmd.exe /d /k " + launchPath + "\" /f";
        var runOnceCmd = "reg add \"HKLM\\OFFLINE_SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\RunOnce\" /v SuperNovaIFEOCleanup /t REG_SZ /d \"reg.exe delete \\\"HKLM\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Image File Execution Options\\sethc.exe\\\" /v Debugger /f\" /f";
        var rIFEO = RunCmd(ifeoCmd);
        var rOnce = RunCmd(runOnceCmd);
        var rUnloadSoftware = RunCmd("reg unload HKLM\\OFFLINE_SOFTWARE");
        if (rUnloadSoftware !== 0) {
            RunCmd("reg delete \"HKLM\\OFFLINE_SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Image File Execution Options\\sethc.exe\" /v Debugger /f");
            rUnloadSoftware = RunCmd("reg unload HKLM\\OFFLINE_SOFTWARE");
            renderResult(false, ["\u2717 Impossible de d\u00e9charger le registre SOFTWARE (code " + rUnloadSoftware + "). Red\u00e9marrez sans utiliser le d\u00e9clencheur et v\u00e9rifiez le disque."]);
            return;
        }

        if (rIFEO === 0) {
            steps.push("\u2713 Options d'ex\u00e9cution (IFEO) configur\u00e9es (usage unique)");
            if (rOnce === 0) {
                steps.push("\u2713 Filet IFEO : nettoyage \u00e0 la prochaine connexion");
            } else {
                steps.push("\u26a0 Filet RunOnce non pos\u00e9 (code " + rOnce + ") \u2014 le d\u00e9clencheur reste \u00e0 usage unique");
            }
            steps.push("\u2713 L'ordinateur est pr\u00eat. Retirez la cl\u00e9 et red\u00e9marrez.");
        } else {
            steps.push("\u2717 Impossible d'injecter la cl\u00e9 IFEO (code " + rIFEO + ")");
            success = false;
        }
        renderResult(success, steps);
    } catch (e) {
        renderResult(false, ["\u2717 Erreur JS: " + e.message]);
    }
}

function renderResult(success, steps) {
    byId("result-status").innerHTML = '<div class="label">R\u00e9sultat</div>' +
        (success
            ? '<span class="found result-ok">\u2713 Pr\u00eat ! Suivez les \u00e9tapes ci-dessous.</span><br><span class="info">\u2713 Permissions du dossier v\u00e9rifi\u00e9es</span>'
            : '<span class="error result-fail">\u2717 Op\u00e9ration \u00e9chou\u00e9e</span><br>' + steps[steps.length - 1]);

    if (success) {
        byId("btn-reboot").className = "btn btn-primary";
        byId("result-steps").innerHTML =
            '<div class="step-title step-title-lg">Prochaines \u00e9tapes</div>' +
            '<div class="next-steps">' +
            '<div>1. \uD83D\uDD0C Retirez la cl\u00e9 USB</div>' +
            '<div>2. \uD83D\uDD04 Red\u00e9marrez le PC</div>' +
            '<div>3. Sur l\'\u00e9cran de login \u2192 appuyez <strong class="hl">5x sur Maj</strong> (une seule fois)</div>' +
            '<div>4. Suivez les instructions \u00e0 l\'\u00e9cran \u2014 le d\u00e9clencheur SYSTEM est retir\u00e9 d\u00e8s l\'ouverture</div>' +
            '</div>';
    } else {
        byId("btn-reboot").className = "btn btn-primary hidden";
        byId("result-steps").innerHTML = '<div class="error">' + steps.join('<br>') + '</div>';
    }
}

function reboot() {
    var shell = new ActiveXObject("WScript.Shell");
    shell.Run("cmd.exe /c shutdown /r /t 5 || wpeutil reboot", 0, false);
    byId("result-status").innerHTML = '<div class="label">Red\u00e9marrage</div><span class="info">\u21ba Red\u00e9marrage en cours...</span>';
}
</script>

</body>
</html>
